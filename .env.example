# ==============================================================================
# Cricbuzz LiveStats - Environment Configuration
# ==============================================================================

# Database Connection (Leave empty or set to 'sqlite' for default local SQLite database)
# Supported types: sqlite, postgresql, mysql
DB_TYPE=sqlite

# SQLite settings (used when DB_TYPE=sqlite)
SQLITE_DB_PATH=database/cricket_analytics.db

# PostgreSQL settings (uncomment and fill when DB_TYPE=postgresql)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=cricket_analytics
# DB_USER=postgres
# DB_PASSWORD=your_password

# MySQL settings (uncomment and fill when DB_TYPE=mysql)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=cricket_analytics
# DB_USER=root
# DB_PASSWORD=your_password

# Alternatively, specify a direct SQLAlchemy connection URL:
# DATABASE_URL=sqlite:///database/cricket_analytics.db
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/cricket_analytics
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/cricket_analytics

# RapidAPI Cricbuzz API Key
# Get key from: https://rapidapi.com/cricketapilive/api/cricbuzz-cricket/
RAPIDAPI_KEY=2fe75634d2mshf7b85a8c84dbbc1p18741ajsnd4dba5799d5d
RAPIDAPI_HOST=cricbuzz-cricket.p.rapidapi.com
